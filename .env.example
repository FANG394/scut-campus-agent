# 默认使用本机 Ollama，不需要 API Key。
# LLM_MODEL 传给 ChatOllama(model=...)；OLLAMA_EMBEDDING_MODEL 传给
# OllamaEmbeddings(model=...)。请用已安装 requirements.txt 的同一 Python 环境启动项目。
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_EMBEDDING_BATCH_SIZE=16

# 接入 OpenAI Responses API 时填写：
# LLM_PROVIDER=openai
# LLM_API_STYLE=responses
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1

# 接入其他 OpenAI-compatible 服务时通常填写：
# LLM_PROVIDER=openai_compatible
# LLM_API_STYLE=chat_completions
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=https://your-provider.example/v1
# 较旧的兼容服务若不接受 max_completion_tokens，可改为 max_tokens：
# LLM_CHAT_TOKEN_FIELD=max_tokens

LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=2048
LLM_CHAT_TOKEN_FIELD=max_completion_tokens

APP_HOST=127.0.0.1
APP_PORT=8000
APP_MAX_HISTORY_MESSAGES=12

RAG_TOP_K=4
RAG_MIN_SCORE=0.60
RAG_MAX_CONTEXT_CHARS=6000
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
